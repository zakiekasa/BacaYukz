        "@vitejs/plugin-react": "^5.2.0",
        "concurrently": "^9.0.1",
        "disqus-react": "^1.1.7",
        "globals": "^15.14.0",
        "laravel-vite-plugin": "^3.1",
        "notyf": "^3.10.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "sweetalert2": "^11.26.25",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.2",
        "vite": "^8.0.0"
